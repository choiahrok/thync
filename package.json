{
  "name": "thync",
  "version": "0.1.0",
  "private": true,
  "description": "Show what you are thinking about and working on as a living brain graph",
  "license": "MIT",
  "scripts": {
    "build": "esbuild web/src/main.ts --bundle --format=iife --target=es2020 --outfile=web/app.js",
    "watch": "esbuild web/src/main.ts --bundle --format=iife --target=es2020 --outfile=web/app.js --watch",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "typescript": "5.4.5"
  }
}
